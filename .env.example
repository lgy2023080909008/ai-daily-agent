# ===== LLM（兼容 OpenAI 协议：DeepSeek / 通义 / 智谱 / OpenAI 都行）=====
# 不填也能跑：没有 key 时自动进入 mock 模式，方便先跑通链路
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# langchain（默认）| http（requests 直连 /chat/completions）
# 如果报 "process() takes no keyword arguments" 这类 SDK 版本错误，改成 http 即可绕过
LLM_BACKEND=langchain

# ===== 抓取 =====
# 启用的数据源（逗号分隔）：
#   arxiv / huggingface / github / rss / hackernews / reddit / hf_models
# reddit 与 hf_models 国内直连通常不通，有代理时再加进来
SOURCES=arxiv,huggingface,github,rss,hackernews
LOOKBACK_HOURS=24
REQUEST_TIMEOUT=15
MAX_RETRIES=3
ARXIV_MAX_RESULTS=40
GITHUB_DAYS=7
# 逗号分隔，任一源失败不影响其他源
RSS_URLS=https://www.jiqizhixin.com/rss,https://www.qbitai.com/feed,https://www.ithome.com/rss/

# ===== 精选（模型直接挑，不用阈值）=====
# 最终推送到邮箱的条数
TOP_N=5
# 送进模型让它挑的候选数量（越小越省钱）
MAX_CANDIDATES=30
# 去重：jaccard（零依赖，默认）| embedding（需要 embeddings 接口）
DEDUP_MODE=jaccard
DEDUP_THRESHOLD=0.86

# ===== 存储 =====
DB_PATH=data/aidaily.db
CACHE_DIR=data/cache
OUT_DIR=data/digests

# ===== 推送 =====
# console（写文件+打印）| email（SMTP，最省事）| feishu（飞书群机器人）
# | wecom（企业微信群机器人）| serverchan（Server酱）
NOTIFY_CHANNEL=console

# 邮件推送（QQ 邮箱为例：设置 → 账户 → 开启 SMTP → 生成授权码，不是登录密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_TO=

FEISHU_WEBHOOK=
WECOM_WEBHOOK=
SERVERCHAN_KEY=
